+  StackPropertyLookupResult old = GetErrorStackProperty(isolate, object);
+  DirectHandle<JSObject> holder;
+  if (old.error_stack_symbol_holder.ToHandle(&holder) &&
+      *holder == *object && IsErrorStackData(*old.error_stack)) {
+    auto trace = direct_handle(
+        Cast<ErrorStackData>(*old.error_stack)->stack_trace(), isolate);
+    value = isolate->factory()->NewErrorStackData(lazy_stack, trace);
+  }
+  RETURN_ON_EXCEPTION(
+      isolate, Object::SetProperty(isolate, object,
+                                   isolate->factory()->error_stack_symbol(),
+                                   value, StoreOrigin::kMaybeKeyed,
+                                   Just(ShouldThrow::kThrowOnError)));
+  return isolate->factory()->undefined_value();
+}
