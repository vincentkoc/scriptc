+Maybe<bool> Exception::SetLazyStackTrace(Local<Context> context,
+                                        Local<Object> target,
+                                        Local<Function> formatter,
+                                        Local<Value> data) {
+  auto i_isolate = reinterpret_cast<i::Isolate*>(context->GetIsolate());
+  ENTER_V8_NO_SCRIPT(i_isolate, context, Exception, SetLazyStackTrace,
+                    i::HandleScope);
+  auto object = Utils::OpenHandle(*target);
+  if (!IsJSObject(*object)) return Just(false);
+  auto result = i::ErrorUtils::SetLazyStackTrace(
+      i_isolate, i::Cast<i::JSObject>(object),
+      Utils::OpenDirectHandle(*formatter), Utils::OpenDirectHandle(*data));
+  i::DirectHandle<i::Object> handle;
+  has_exception = !result.ToHandle(&handle);
+  RETURN_ON_FAILED_EXECUTION_PRIMITIVE(bool);
+  return Just(true);
+}
