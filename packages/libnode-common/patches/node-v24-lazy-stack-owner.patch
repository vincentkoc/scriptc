+MaybeHandle<Object> ErrorUtils::SetLazyStackTrace(
+    Isolate* isolate, DirectHandle<JSObject> object,
+    DirectHandle<JSReceiver> formatter, DirectHandle<Object> data) {
+  DCHECK(IsCallable(*formatter));
+  MAYBE_RETURN(InstallStackAccessors(isolate, object), {});
+  auto lazy_stack = isolate->factory()->NewTuple2(
+      formatter, data, AllocationType::kYoung);
